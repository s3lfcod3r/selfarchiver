# --- SelfArchiver configuration ---------------------------------------------
# Copy to .env and adjust. All variables are optional except where noted.

# HTTP port the app listens on (host side of the Docker mapping).
PORT=3000

# Stable secret used to encrypt stored mailbox passwords and sign sessions.
# IMPORTANT: set this and keep it constant — changing it makes stored mailbox
# passwords undecryptable. Generate one with:  openssl rand -hex 32
# If left empty, a secret is generated once and stored in the data volume.
APP_SECRET=

# Optional single-admin password protecting the web UI. Empty = open instance
# (only do that on a trusted private network — see the security notes in README).
AUTH_PASSWORD=

# Set to "true" when serving over HTTPS (e.g. behind a reverse proxy) so the
# session cookie is only sent over secure connections.
COOKIE_SECURE=false

# Timezone for evaluating per-rule cron schedules.
TZ=Europe/Berlin
CRON_TZ=Europe/Berlin

# Log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Non-Docker / advanced --------------------------------------------------
# Where the SQLite DB + .eml archive live (inside the container this is /data).
# DATA_DIR=./data
